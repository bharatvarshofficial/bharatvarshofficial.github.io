rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "hGrTepDbtsaCoSQL5D2bBG0iZzD2";
    }

    function isSupportedMediaType(mediaType) {
      return (
        mediaType == "videos"
        && request.resource.contentType.matches('video/.*')
      ) || (
        (mediaType == "wallpapers" || mediaType == "images")
        && request.resource.contentType.matches('image/.*')
      );
    }

    function isWithinSizeLimit(mediaType) {
      return (
        mediaType == "videos"
        && request.resource.size <= 250 * 1024 * 1024
      ) || (
        (mediaType == "wallpapers" || mediaType == "images")
        && request.resource.size <= 25 * 1024 * 1024
      );
    }

    match /media/{mediaType}/{userId}/{fileName} {
      allow read: if true;

      allow create, update: if isAdmin()
        && userId == request.auth.uid
        && isSupportedMediaType(mediaType)
        && isWithinSizeLimit(mediaType);

      allow delete: if isAdmin()
        && userId == request.auth.uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
